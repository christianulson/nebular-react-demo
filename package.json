{
  "name": "nebular-react-demo",
  "private": true,
  "version": "0.2.0",
  "description": "Nebular React Demo",
  "repository": "https://github.com/hirol888/nebular-react-demo",
  "author": "Huining Li <nebularreact@gmail.com>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "yarn typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint src --cache",
    "lint:fix": "eslint src --cache --fix",
    "prettier": "prettier --check \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.{ts,js,json,md}\"",
    "prettier:write": "prettier --write \"src/**/*.{ts,tsx}\" \"e2e/**/*.ts\" \"*.{ts,js,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "yarn typecheck && yarn lint && yarn prettier && yarn test && vite build",
    "verify:full": "yarn verify && yarn test:e2e"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^12.0.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/serialize": "^1.3.3",
    "@emotion/utils": "^1.4.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@mantine/hooks": "^9.8.1",
    "@nebular-react/core": "1.0.0",
    "@nebular-react/hooks": "1.0.0",
    "@nebular-react/styles": "1.0.0",
    "@react-google-maps/api": "^2.20.8",
    "@tanstack/react-table": "^9.3.1",
    "@tinymce/tinymce-react": "^6.3.1",
    "bootstrap": "^5.3.9",
    "chart.js": "^4.6.1",
    "ckeditor5": "^49.1.0",
    "clsx": "2.1.1",
    "csstype": "3.2.4",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.1.0",
    "ionicons": "^8.1.0",
    "leaflet": "^1.9.4",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "nebular-icons": "^1.1.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.6",
    "react-transition-group": "4.4.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/google.maps": "^3.66.10",
    "@types/leaflet": "^1.9.22",
    "@types/lodash": "^4.17.27",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vitest-axe": "^0.1.0"
  }
}
